# ─────────────────────────────────────────────────────────────────────────────
# Aelum release secrets — LOCAL ONLY.
#
# 1. Copy this file:            cp release.env.example release.env
# 2. Fill in your values.
# 3. Commit NOTHING — release.env is gitignored (see .gitignore).
#
# The release scripts read every credential from the environment (this file is
# sourced by `make release`). Because the values live only in this untracked
# file, they are never baked into the scripts or pushed to git — the same scripts
# run from any machine/VM, just supply your own release.env there.
# ─────────────────────────────────────────────────────────────────────────────

# --- Cloudflare R2 (upload destination) ---
# Account ID (top-right of the Cloudflare dashboard) + an R2 API token with
# Object Read & Write on the `aelum` bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Optional CDN domain the assets are served from (default: https://cdn.aelum.dev).
R2_PUBLIC_BASE=https://cdn.aelum.dev

# --- GPG release signing key (sign the ISO) ---
# Key id or "Name <email>", the armored PRIVATE key (base64) for headless
# signing, and its passphrase.
AELUM_GPG_KEY=
AELUM_GPG_PRIVATE_KEY_B64=
GPG_PASSPHRASE=

# --- Website link update ---
# Auth for pushing release.ts to the website repo. Prefer a GitHub fine-grained
# PAT with "Contents: Read and write" on the website repo; leave the token empty
# to use the logged-in `gh` CLI token instead (handy on a local release machine).
# GitHub ignores the username for token auth; 'x-access-token' is conventional.
WEBSITE_TOKEN_USER=x-access-token
WEBSITE_DEPLOY_TOKEN=
WEBSITE_REPO=https://github.com/aelum-dev/website.git

# --- Signing-key metadata shown on the website (optional) ---
# The key itself is published via WKD at
# https://aelum.dev/.well-known/openpgpkey/ (see docker/scripts/export-wkd.sh).
AELUM_SIGNING_UID="Aelum Release <release@aelum.dev>"
AELUM_SIGNING_FP=728F5F59FB2F5A88C6EE28D4930A672A3A1B5B60
AELUM_SIGNING_FP_TOP="728F 5F59 FB2F 5A88 C6EE"
AELUM_SIGNING_FP_BOT="28D4 930A 672A 3A1B 5B60"
AELUM_SIGNING_EXPIRES=never
